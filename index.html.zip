<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CrieAI - Gerador de Código</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #0A0A0F;
            --card-bg: #12121A;
            --card-border: rgba(255, 255, 255, 0.08);
            --purple-primary: #7C3AED;
            --purple-light: #A78BFA;
            --text-main: #FFFFFF;
            --text-muted: #9CA3AF;
            --green-accent: #10B981;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background-color: var(--bg-dark); color: var(--text-main); overflow-x: hidden; }

        nav {
            position: fixed;
            top: 15px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 800px;
            background: rgba(18, 18, 26, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
        }

        .logo { font-size: 1.2rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 8px; }
        .logo span { color: var(--purple-light); }

        .menu-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--card-border);
            color: #fff;
            padding: 8px 14px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 1.2rem;
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            top: 60px;
            right: 0;
            width: 300px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 15px;
            flex-direction: column;
            gap: 10px;
            z-index: 1001;
        }
        .dropdown-menu.active { display: flex; }
        .dropdown-header { font-size: 0.75rem; font-weight: 700; color: var(--purple-light); text-transform: uppercase; }

        .search-box { display: flex; gap: 6px; }
        .search-box input { padding: 8px; font-size: 0.85rem; border-radius: 6px; border: 1px solid var(--card-border); background: #000; color: #fff; flex: 1; }
        .search-box button { background: var(--purple-primary); color: #fff; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; }

        .container { max-width: 800px; margin: 0 auto; padding: 100px 20px 40px; }
        .pricing-card { background: var(--card-bg); border: 2px solid var(--purple-primary); border-radius: 20px; padding: 30px; text-align: center; }
        
        .btn-primary { background: var(--purple-primary); color: #fff; padding: 16px 32px; border-radius: 30px; font-weight: 700; font-size: 1rem; border: none; cursor: pointer; width: 100%; margin-top: 15px; }

        #generatorModal { display: none; margin-top: 30px; }
        .form-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 25px; display: flex; flex-direction: column; gap: 16px; }
        input, select, textarea { width: 100%; padding: 12px; background: #0A0A0F; border: 1px solid var(--card-border); border-radius: 8px; color: #fff; }
        .row-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

        .code-box { background: #050508; border: 1px solid var(--card-border); border-radius: 12px; padding: 15px; font-family: monospace; font-size: 0.85rem; color: #A78BFA; white-space: pre-wrap; word-break: break-all; max-height: 250px; overflow-y: auto; margin-top: 15px; }
        .btn-copy { background: var(--green-accent); color: #000; padding: 12px; border-radius: 8px; border: none; font-weight: 800; cursor: pointer; width: 100%; margin-top: 10px; }
    </style>
</head>
<body>

    <nav>
        <div class="logo"><i class="fa-solid fa-wand-magic-sparkles"></i> Crie<span>AI</span></div>
        <div style="position: relative;">
            <button class="menu-btn" onclick="toggleCompaniesMenu()"><i class="fa-solid fa-ellipsis-vertical"></i></button>
            <div class="dropdown-menu" id="companiesMenu">
                <div class="dropdown-header">Buscar Empresa no Brasil (Google Maps)</div>
                <div class="search-box">
                    <input type="text" id="mapSearchInput" placeholder="Nome da empresa ou cidade...">
                    <button onclick="searchMaps()"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="pricing-card">
            <h2>Gerador de Código de Sites</h2>
            <p style="color: var(--text-muted); margin-top: 8px;">Configure os dados da sua empresa para gerar o código completo.</p>
            <button class="btn-primary" onclick="openGenerator()"><i class="fa-solid fa-wand-magic-sparkles"></i> Criar Site Grátis Agora</button>
        </div>

        <div id="generatorModal">
            <div class="form-card">
                <div>
                    <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">MODO DE CRIAÇÃO</label>
                    <select id="createMode" onchange="toggleMode()">
                        <option value="zero">Criar do Zero</option>
                        <option value="ready">Empresa Pronta</option>
                    </select>
                </div>

                <div>
                    <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">NOME DA EMPRESA</label>
                    <input type="text" id="businessName" placeholder="Ex: Studio Auto Car">
                </div>

                <div>
                    <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">SUBTÍTULO / SLOGAN</label>
                    <input type="text" id="businessSubtitle" placeholder="Ex: Qualidade e confiança">
                </div>

                <div class="row-inputs">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">FONTE</label>
                        <select id="fontFamily">
                            <option value="Plus Jakarta Sans">Plus Jakarta Sans</option>
                            <option value="Poppins">Poppins</option>
                            <option value="Inter">Inter</option>
                            <option value="Roboto">Roboto</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">COR PRINCIPAL</label>
                        <input type="color" id="primaryColor" value="#7C3AED" style="height: 45px; cursor: pointer;">
                    </div>
                </div>

                <div>
                    <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">TEXTO SOBRE A EMPRESA</label>
                    <textarea id="businessDesc" rows="3" placeholder="Digite o texto explicativo da empresa..."></textarea>
                </div>

                <div class="row-inputs">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">TELEFONE</label>
                        <input type="text" id="businessPhone" placeholder="(12) 98814-8291">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">GMAIL</label>
                        <input type="email" id="businessEmail" placeholder="contato@gmail.com">
                    </div>
                </div>

                <div>
                    <label style="font-size: 0.8rem; color: var(--purple-light); font-weight: bold;">ENDEREÇO</label>
                    <input type="text" id="businessAddress" placeholder="Rua, Número - Bairro, Cidade">
                </div>

                <button class="btn-primary" onclick="generateCode()"><i class="fa-solid fa-code"></i> Gerar Código</button>
            </div>

            <div id="outputArea" style="display:none; margin-top:20px;">
                <div class="code-box" id="codeResult"></div>
                <button class="btn-copy" onclick="copyCode()"><i class="fa-solid fa-copy"></i> Copiar Código</button>
            </div>
        </div>
    </div>

    <script>
        function toggleCompaniesMenu() {
            document.getElementById('companiesMenu').classList.toggle('active');
        }

        function searchMaps() {
            const query = document.getElementById('mapSearchInput').value.trim();
            if (query) {
                window.open(`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`, '_blank');
            }
        }

        function openGenerator() {
            document.getElementById('generatorModal').style.display = 'block';
        }

        function toggleMode() {
            const mode = document.getElementById('createMode').value;
            if (mode === 'ready') {
                document.getElementById('businessName').value = "Restaurante da Jojô";
                document.getElementById('businessSubtitle').value = "O melhor da comida caseira";
                document.getElementById('businessDesc').value = "Oferecemos pratos feitos com ingredientes frescos e tempero especial de família.";
                document.getElementById('businessPhone').value = "(12) 98814-8291";
                document.getElementById('businessEmail').value = "restaurantedajojo@gmail.com";
                document.getElementById('businessAddress').value = "Rua Principal, 100 - Centro";
            } else {
                document.getElementById('businessName').value = "";
                document.getElementById('businessSubtitle').value = "";
                document.getElementById('businessDesc').value = "";
                document.getElementById('businessPhone').value = "";
                document.getElementById('businessEmail').value = "";
                document.getElementById('businessAddress').value = "";
            }
        }

        function generateCode() {
            const name = document.getElementById('businessName').value || 'Minha Empresa';
            const subtitle = document.getElementById('businessSubtitle').value || 'Subtítulo';
            const font = document.getElementById('fontFamily').value;
            const color = document.getElementById('primaryColor').value;
            const desc = document.getElementById('businessDesc').value || 'Descrição da empresa.';
            const phone = document.getElementById('businessPhone').value || 'Não informado';
            const email = document.getElementById('businessEmail').value || 'contato@gmail.com';
            const address = document.getElementById('businessAddress').value || 'Não informado';

            const generatedHtml = `<div style="font-family: '${font}'; background: #0A0A0F; color: #fff; padding: 30px; border-radius: 12px;">
  <header style="text-align: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 20px;">
    <h1 style="color: ${color}; font-size: 2.2rem;">${name}</h1>
    <p style="opacity: 0.8; font-size: 1.1rem;">${subtitle}</p>
  </header>
  
  <main style="margin: 30px 0; line-height: 1.6;">
    <p>${desc}</p>
  </main>

  <footer style="margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center;">
    <h3 style="color: ${color}; margin-bottom: 15px;">Entre em Contato</h3>
    <p style="margin-bottom: 8px;">📞 Telefone: <strong>${phone}</strong></p>
    <p style="margin-bottom: 8px;">✉️ Gmail: <span style="color: #3B82F6; font-weight: bold;">${email}</span></p>
    <p>📍 Endereço: <strong>${address}</strong></p>
  </footer>
</div>`;

            document.getElementById('codeResult').innerText = generatedHtml;
            document.getElementById('outputArea').style.display = 'block';
        }

        function copyCode() {
            const codeText = document.getElementById('codeResult').innerText;
            navigator.clipboard.writeText(codeText).then(() => alert("Código copiado com sucesso!"));
        }
    </script>
</body>
</html>
